# Generated by Ansible from the shared appearance palette.
# Theme source-of-truth snapshot:
#   background={{ appearance_theme_special.background }}
#   foreground={{ appearance_theme_special.foreground }}
#   cursor={{ appearance_theme_special.cursor }}
#   color1={{ appearance_theme_colors.color1 }}
#   color2={{ appearance_theme_colors.color2 }}
#   color3={{ appearance_theme_colors.color3 }}
#   color4={{ appearance_theme_colors.color4 }}
#   color5={{ appearance_theme_colors.color5 }}
#   color6={{ appearance_theme_colors.color6 }}
#
# Tig itself has no truecolor support. This config stays static on the target
# and relies on the terminal's ANSI palette, which is already themed elsewhere
# in this repo.

color default             default default
color cursor              color15 color8  bold
color title-focus         color0  color4  bold
color title-blur          color7  color8
color status              color4  default
color delimiter           color8  default
color search-result       color0  color3  bold

color date                color8  default
color author              color5  default
color id                  color3  default
color line-number         color8  default
color overflow            color9  default
color header              color4  default bold
color section             color6  default bold
color mode                color8  default
color directory           color4  default bold
color file                default default
color file-size           color8  default

color main-head           color4  default bold
color main-remote         color2  default
color main-tracked        color6  default bold
color main-tag            color3  default bold
color main-local-tag      color3  default
color main-ref            color5  default
color graph-commit        color4  default

color diff-header         color5  default bold
color diff-index          color8  default
color diff-chunk          color4  default
color "@@"               color4  default
color diff-add            color10 default
color diff-del            color9  default
color diff-add-highlight  color0  color10 bold
color diff-del-highlight  color15 color9  bold
color diff-stat           color6  default
color diff-oldmode        color8  default
color diff-newmode        color8  default
color "--- "             color8  default
color "+++ "             color8  default

color "commit "          color3  default bold
color "Author: "         color5  default
color "AuthorDate: "     color8  default
color "Commit: "         color5  default
color "CommitDate: "     color8  default
color "Refs: "           color6  default
color "Date: "           color8  default
color "Merge: "          color8  default
color "    Signed-off-by:" color8 default
color "    Co-authored-by:" color8 default
color "    Reviewed-by:" color8  default

color tree.header         color4  default bold
color help-group          color5  default bold
color help-action         color6  default

color status.header       color4  default bold
color status.section      color5  default
color stat-staged         color2  default
color stat-unstaged       color3  default
color stat-untracked      color8  default
color stat-none           color8  default

color grep.file           color4  default bold
color grep.line-number    color8  default
color grep.delimiter      color8  default

color palette-0           color5  default
color palette-1           color6  default
color palette-2           color3  default
color palette-3           color2  default
color palette-4           color4  default
color palette-5           color1  default
color palette-6           color13 default
color palette-7           color14 default
color palette-8           color11 default
color palette-9           color10 default
color palette-10          color12 default
color palette-11          color9  default
color palette-12          color7  default
color palette-13          color8  default
