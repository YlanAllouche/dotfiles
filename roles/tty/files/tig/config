# Core Tig settings
set git-colors        = no
set line-graphics     = utf-8
set tab-size          = 4
set refresh-mode      = auto
set wrap-lines        = no
set ignore-case       = smart-case
set show-changes      = no
set start-on-head     = yes
set focus-child       = no

# Base config pieces.
source ~/.config/tig/color.tigrc
source ~/.config/tig/view.tigrc
source ~/.config/tig/bind.tigrc

# Optional drop-ins.
source -q ~/.config/tig/forge.tigrc
source -q ~/.config/tig/perf.tigrc
source -q ~/.config/tig/local.tigrc
